#!/usr/bin/env python3
"""Launcher for the token usage viewer.

Works both in-place and when symlinked into a PATH directory: the repository
root is resolved from this file's real location.
"""

import os
import sys
from pathlib import Path

REPO = Path(os.path.realpath(__file__)).resolve().parent.parent
sys.path.insert(0, str(REPO / "src"))

import viewer  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(viewer.main())
